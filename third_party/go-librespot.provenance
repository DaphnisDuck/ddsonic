active-h1 h1:ER7G3hzK8BwqNYZOGNhWlUpcJ0n0Lyoxw0ISQ0zRoYc=
patch patches/go-librespot/0001-player-guard-cdn-quarantine-map.patch sha256:a3888e30d63ccc8845b62966b28870de64ec60e82d4d917bcb635c0387e8152e
patch patches/go-librespot/0002-audio-key-requests-across-connection-changes.patch sha256:49daf3eb236efc5f50abc94ed5925a84c9c0a74aff04ddd95a77c0e1dedf5672
